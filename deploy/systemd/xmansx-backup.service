[Unit]
Description=XMANSX encrypted PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xmansx
Group=xmansx
EnvironmentFile=/etc/xmansx/xmansx.env
ExecStart=/opt/xmansx/current/deploy/backup/xmansx-backup.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/xmansx
