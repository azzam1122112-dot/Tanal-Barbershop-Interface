[Unit]
Description=XMANSX privacy retention and maintenance cleanup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=tanal
Group=tanal
WorkingDirectory=/srv/tanal/app
EnvironmentFile=/etc/tanal/tanal.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/npm run maintenance:cleanup
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/tanal
