generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SUPERVISOR
  BARBER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentMethod {
  CASH
  NETWORK
}

enum VisitStatus {
  COMPLETED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashCustodyMovementType {
  OPENING_BALANCE
  CASH_SALE
  CASH_EXPENSE
  COLLECTION
  COLLECTION_REVERSAL
  VISIT_REVERSAL
  PAYMENT_METHOD_ADJUSTMENT
  VISIT_AMOUNT_ADJUSTMENT
  EXPENSE_REVERSAL
  COUNT_ADJUSTMENT
  SAFE_OWNER_PICKUP
  SAFE_BANK_DEPOSIT
}

enum CashCollectionScheduleMode {
  DISABLED
  INTERVAL
  WEEKDAYS
}

enum DiscountType {
  NONE
  REWARD
  CAMPAIGN
  MANAGER_REWARD
}

enum CampaignDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum CampaignTargetType {
  ALL_CUSTOMERS
  NEW_CUSTOMERS
  INACTIVE_CUSTOMERS
  CUSTOMERS_WITH_MIN_POINTS
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REVERSAL
}

enum AuditActorType {
  PLATFORM_ADMIN
  OWNER
  ADMIN
  SUPERVISOR
  BARBER
  // العميل نفسه من بوابته (حجز أو إلغاء موعد). فاعل حقيقي بلا حساب في النظام،
  // فلا يصح وسمه SYSTEM وإلا ضاع الفرق بين فعل العميل وفعل آلي.
  CUSTOMER
  SYSTEM
}

enum WhatsAppTemplateType {
  POST_VISIT
  REWARD_READY
  CAMPAIGN
  INACTIVE_CUSTOMER
  CUSTOM
}

enum WhatsAppMessageStatus {
  DRAFTED
  OPENED
  MARKED_SENT
  SKIPPED
  FAILED
}

enum WhatsAppMessageCategory {
  TRANSACTIONAL
  MARKETING
  SERVICE
}

enum WhatsAppConsentSource {
  IN_PERSON
  WEBSITE
  WHATSAPP
  PHONE
  IMPORTED
  OTHER
}

enum WhatsAppSafetyMode {
  STRICT
  BALANCED
  CUSTOM
}

enum ExpenseCategory {
  SUPPLIES
  MAINTENANCE
  UTILITIES
  STAFF_ADVANCE
  REFUND
  OTHER
}

enum ExpensePaymentSource {
  CASH_DRAWER
  EXTERNAL
}

enum AppointmentStatus {
  BOOKED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  STAFF
  CUSTOMER
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
  RETURN
}

enum AttendanceSource {
  SELF
  MANAGER
}

// طريقة تحصيل الاشتراك. حاليًا يدوي (تحويل بنكي/نقدًا) يسجّله مدير المنصة.
// إضافة بوابة لاحقًا = قيمة جديدة هنا + محوّل يكتب نفس `BillingInvoice`.
enum PaymentProvider {
  MANUAL_TRANSFER
  MANUAL_CASH
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum DataSubjectRequestType {
  ACCESS
  COPY
  CORRECTION
  DELETION
  WITHDRAW_CONSENT
}

enum DataSubjectRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// ===== Platform / Tenancy =====

// مدير المنصة (super-admin) — يدير كل المؤسسات والباقات. خارج أي مستأجر.
model PlatformAdmin {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  isActive              Boolean                @default(true)
  mfaEnabledAt          DateTime?
  mfaSecretCiphertext   String?
  mfaPendingCiphertext  String?
  mfaRecoveryCodeHashes String[]               @default([])
  mfaLastUsedStep       BigInt?
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  mfaChallenges         PlatformMfaChallenge[]
}

model PlatformMfaChallenge {
  id              String        @id @default(cuid())
  tokenHash       String        @unique
  platformAdminId String
  expiresAt       DateTime
  attempts        Int           @default(0)
  consumedAt      DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId, expiresAt])
  @@index([expiresAt, consumedAt])
}

// الباقة هي مصدر الحقيقة للوحة المنصة وصفحة الهبوط وصفحة اشتراك المؤسسة.
model Plan {
  id              String           @id @default(cuid())
  name            String           @unique
  slug            String           @unique
  description     String?
  priceMonthly    Decimal          @default(0) @db.Decimal(10, 2)
  priceYearly     Decimal?         @db.Decimal(10, 2)
  features        String[]         @default([])
  maxSalons       Int              @default(1)
  maxBarbers      Int? // null = غير محدود
  maxCustomers    Int?
  isActive        Boolean          @default(true)
  isPublic        Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  isSignupDefault Boolean          @default(false)
  // مدة التجربة التي يحصل عليها التسجيل الذاتي عند جعل الباقة افتراضية.
  trialDays       Int              @default(14)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizations   Organization[]
  billingInvoices BillingInvoice[]

  @@index([isActive, isPublic, sortOrder])
}

// المؤسسة (المالك) — حدّ العزل الأساسي + العميل/الولاء + الفوترة.
model Organization {
  id                     String             @id @default(cuid())
  name                   String
  city                   String?
  slug                   String             @unique // النطاق الفرعي
  status                 OrganizationStatus @default(ACTIVE)
  planId                 String?
  subscriptionStatus     SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  // يبدأ عند توقف التجربة/الاشتراك فعليًا. بعد 60 يومًا تحذف الصيانة الحساب وبياناته.
  inactiveSince          DateTime?
  termsAcceptedAt        DateTime?
  termsVersion           String?
  privacyAcceptedAt      DateTime?
  privacyVersion         String?
  dpaAcceptedAt          DateTime?
  dpaVersion             String?
  legalAcceptedIp        String?
  legalAcceptedUserAgent String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  plan                    Plan?                    @relation(fields: [planId], references: [id])
  salons                  Salon[]
  users                   User[]
  barbers                 Barber[]
  customers               Customer[]
  services                Service[]
  visits                  Visit[]
  loyaltyAccounts         LoyaltyAccount[]
  loyaltyTransactions     LoyaltyTransaction[]
  rewardRules             RewardRule[]
  campaigns               Campaign[]
  campaignRedemptions     CampaignRedemption[]
  managerRewards          ManagerReward[]
  dailyCloses             DailyClose[]
  cashSessions            CashSession[]
  systemSettings          SystemSettings[]
  whatsappTemplates       WhatsAppTemplate[]
  whatsappMessages        WhatsAppMessageLog[]
  whatsappSafetySettings  WhatsAppSafetySettings?
  auditLogs               AuditLog[]
  sessions                Session[]
  staffSalons             StaffSalon[]
  cashExpenses            CashExpense[]
  barberCashBalances      BarberCashBalance[]
  branchCashSafes         BranchCashSafe[]
  cashCustodyMovements    CashCustodyMovement[]
  cashCollections         CashCollection[]
  cashCollectionPolicies  CashCollectionPolicy[]
  appointments            Appointment[]
  products                Product[]
  stockMovements          StockMovement[]
  attendance              AttendanceRecord[]
  billingInvoices         BillingInvoice[]
  barberPushSubscriptions BarberPushSubscription[]
  dataSubjectRequests     DataSubjectRequest[]

  @@index([status])
  @@index([planId])
  @@index([subscriptionStatus, inactiveSince])
}

// الصالون — الوحدة التشغيلية داخل المؤسسة.
model Salon {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barbers              Barber[]
  services             Service[]
  visits               Visit[]
  cashSessions         CashSession[]
  dailyCloses          DailyClose[]
  settings             SystemSettings?
  sessions             Session[]
  staffAssignments     StaffSalon[]
  cashExpenses         CashExpense[]
  barberCashBalances   BarberCashBalance[]
  branchCashSafe       BranchCashSafe?
  cashCustodyMovements CashCustodyMovement[]
  cashCollections      CashCollection[]
  cashCollectionPolicy CashCollectionPolicy?
  appointments         Appointment[]
  products             Product[]
  stockMovements       StockMovement[]
  attendance           AttendanceRecord[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
}

// إسناد مشرف (User بدور SUPERVISOR) إلى فرع محدد. مشرف واحد يمكن إسناده لعدة فروع.
// المالك والمدير على مستوى المؤسسة دائمًا فلا يحتاجان إسنادًا هنا.
model StaffSalon {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  salonId        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([userId, salonId])
  @@index([salonId])
  @@index([organizationId])
}

// ===== Tenant data =====

model User {
  id                         String               @id @default(cuid())
  organizationId             String
  name                       String
  email                      String?
  phone                      String
  passwordHash               String
  role                       UserRole             @default(ADMIN)
  isActive                   Boolean              @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  organization               Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs                  AuditLog[]
  sessions                   Session[]
  dailyCloses                DailyClose[]         @relation("DailyCloseReceivedBy")
  closedCashSessions         CashSession[]        @relation("CashSessionClosedBy")
  cancelledVisits            Visit[]              @relation("VisitCancelledBy")
  openedWhatsAppMessages     WhatsAppMessageLog[] @relation("WhatsAppOpenedBy")
  markedSentWhatsAppMessages WhatsAppMessageLog[] @relation("WhatsAppMarkedSentBy")
  issuedManagerRewards       ManagerReward[]      @relation("ManagerRewardIssuedBy")
  salonAssignments           StaffSalon[]
  collectedCash              CashCollection[]     @relation("CashCollectionCollectedBy")
  reversedCashCollections    CashCollection[]     @relation("CashCollectionReversedBy")

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([organizationId, role, isActive])
}

model Barber {
  id                   String                   @id @default(cuid())
  organizationId       String
  salonId              String
  name                 String
  phone                String
  accessPinHash        String
  role                 UserRole                 @default(BARBER)
  isActive             Boolean                  @default(true)
  // بوابة صريحة لحساب العمولة وإظهار مستحقاتها للحلاق.
  commissionEnabled    Boolean                  @default(false)
  // نسبة عمولة الحلاق %. null = استخدم النسبة الافتراضية للفرع.
  commissionRate       Decimal?                 @db.Decimal(5, 2)
  // دوام الحلاق للحجز الذاتي. عند التعطيل يرث دوام الفرع وإجازاته.
  workScheduleEnabled  Boolean                  @default(false)
  workStartMinute      Int                      @default(960)
  workEndMinute        Int                      @default(1380)
  workClosedWeekdays   Int[]                    @default([])
  lastLoginAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon                Salon                    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdCustomers     Customer[]               @relation("CustomerCreatedByBarber")
  visits               Visit[]
  auditLogs            AuditLog[]               @relation("BarberAuditLogs")
  sessions             Session[]
  dailyCloses          DailyClose[]
  cashSessions         CashSession[]
  expenses             CashExpense[]            @relation("CashExpenseBarber")
  appointments         Appointment[]
  attendance           AttendanceRecord[]
  pushSubscriptions    BarberPushSubscription[]
  cashBalance          BarberCashBalance?
  cashCustodyMovements CashCustodyMovement[]
  cashCollections      CashCollection[]

  @@unique([organizationId, phone])
  @@index([salonId, isActive])
  @@index([organizationId])
}

model Session {
  id                     String                  @id @default(cuid())
  tokenHash              String                  @unique
  actorType              AuditActorType
  organizationId         String?
  activeSalonId          String?
  userId                 String?
  barberId               String?
  platformAdminId        String?
  role                   UserRole?
  createdAt              DateTime                @default(now())
  expiresAt              DateTime
  lastUsedAt             DateTime?
  revokedAt              DateTime?
  mfaVerifiedAt          DateTime?
  mfaSetupOnly           Boolean                 @default(false)
  userAgent              String?
  ipAddress              String?
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  barber                 Barber?                 @relation(fields: [barberId], references: [id], onDelete: Cascade)
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeSalon            Salon?                  @relation(fields: [activeSalonId], references: [id], onDelete: SetNull)
  platformAdmin          PlatformAdmin?          @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  barberPushSubscription BarberPushSubscription?

  @@index([tokenHash])
  @@index([userId, revokedAt])
  @@index([barberId, revokedAt])
  @@index([expiresAt])
  @@index([organizationId])
  @@index([platformAdminId])
}

// اشتراك Web Push مرتبط بجلسة حلاق بعينها. مسار الخروج يحذفه في نفس معاملة
// إلغاء الجلسة، بينما يسمح للحلاق بأكثر من جهاز عبر جلسة مستقلة لكل جهاز.
model BarberPushSubscription {
  id             String    @id @default(cuid())
  organizationId String
  barberId       String
  sessionId      String    @unique
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  lastSuccessAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([barberId, updatedAt])
  @@index([organizationId])
}

model Customer {
  id                             String                 @id @default(cuid())
  organizationId                 String
  name                           String
  phone                          String
  // المفتاح العام مشتق من وجود موافقة واحدة على الأقل، ويُبقى للتوافق مع الواجهات القديمة.
  whatsappOptIn                  Boolean                @default(false)
  whatsappTransactionalOptIn     Boolean                @default(false)
  whatsappMarketingOptIn         Boolean                @default(false)
  whatsappConsentSource          WhatsAppConsentSource?
  whatsappTransactionalConsentAt DateTime?
  whatsappMarketingConsentAt     DateTime?
  whatsappOptOutAt               DateTime?
  whatsappOptOutReason           String?
  whatsappLastContactedAt        DateTime?
  whatsappLastMarketingAt        DateTime?
  // لا يُخزّن رمز البوابة الصريح؛ SHA-256 فقط مع صلاحية محدودة.
  portalTokenHash                String?                @unique
  portalTokenIssuedAt            DateTime?
  portalTokenExpiresAt           DateTime?
  // إثبات عرض إشعار الخصوصية قبل التسجيل العام (اطلاع، وليس موافقة تسويقية).
  privacyNoticeAcknowledgedAt    DateTime?
  privacyNoticeVersion           String?
  privacyNoticeControllerName    String?
  // سياسة الحجز: عند الغياب عن موعدين يُعلَّق الحجز الذاتي حتى تصحيح إحدى الحالتين.
  bookingNoShowCount             Int                    @default(0)
  bookingBlockedAt               DateTime?
  bookingBlockReason             String?
  visitCount                     Int                    @default(0)
  totalPaid                      Decimal                @default(0) @db.Decimal(12, 2)
  lastVisitAt                    DateTime?
  lastBarberId                   String?
  createdByBarberId              String?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  organization                   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByBarber                Barber?                @relation("CustomerCreatedByBarber", fields: [createdByBarberId], references: [id])
  visits                         Visit[]
  loyaltyAccount                 LoyaltyAccount?
  loyaltyTransactions            LoyaltyTransaction[]
  campaignRedemptions            CampaignRedemption[]
  managerRewards                 ManagerReward[]
  whatsappMessages               WhatsAppMessageLog[]
  appointments                   Appointment[]
  dataSubjectRequests            DataSubjectRequest[]

  @@unique([organizationId, phone])
  @@index([organizationId, lastVisitAt])
  @@index([organizationId, whatsappOptIn])
  @@index([organizationId, whatsappMarketingOptIn])
  @@index([organizationId, whatsappLastMarketingAt])
  @@index([organizationId, bookingBlockedAt])
  @@index([createdByBarberId])
}

model Service {
  id              String         @id @default(cuid())
  organizationId  String
  salonId         String
  name            String
  defaultPrice    Decimal        @db.Decimal(10, 2)
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  // مدة الخدمة بالدقائق — تُستخدم لحساب نهاية الموعد.
  durationMinutes Int            @default(30)
  // نسبة عمولة خاصة بهذه الخدمة %. null = استخدم نسبة الحلاق ثم الفرع.
  commissionRate  Decimal?       @db.Decimal(5, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon           Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  visitServices   VisitService[]

  @@unique([salonId, name])
  @@index([salonId, isActive, sortOrder])
  @@index([organizationId])
}

model Visit {
  id                  String               @id @default(cuid())
  organizationId      String
  salonId             String
  // العملية المالية لا تتطلب بيانات شخصية؛ يبقى العميل اختياريًا للولاء والتاريخ.
  customerId          String?
  barberId            String
  status              VisitStatus          @default(COMPLETED)
  grossAmount         Decimal              @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(10, 2)
  // netAmount = المبلغ المدفوع فعليًا بعد الخصم — أساس كل التجميعات المالية.
  netAmount           Decimal              @db.Decimal(10, 2)
  invoiceNumber       String?
  // عمولة الحلاق محسوبة وقت الزيارة على المبلغ بعد الخصم.
  commissionAmount    Decimal              @default(0) @db.Decimal(10, 2)
  paymentMethod       PaymentMethod
  // تفاصيل التحصيل النقدي لتحويل شاشة الحلاق إلى نقطة بيع فعلية.
  cashTenderedAmount  Decimal?             @db.Decimal(10, 2)
  cashChangeAmount    Decimal?             @db.Decimal(10, 2)
  discountType        DiscountType         @default(NONE)
  discountSourceId    String?
  idempotencyKey      String?
  pointsEarned        Int                  @default(0)
  notes               String?
  closedAt            DateTime?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancelReason        String?
  visitedAt           DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon               Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  barber              Barber               @relation(fields: [barberId], references: [id])
  services            VisitService[]
  loyaltyTransactions LoyaltyTransaction[]
  campaignRedemption  CampaignRedemption?
  managerReward       ManagerReward?
  cancelledBy         User?                @relation("VisitCancelledBy", fields: [cancelledByUserId], references: [id])
  cashSessionId       String?
  cashSession         CashSession?         @relation(fields: [cashSessionId], references: [id])
  whatsappMessages    WhatsAppMessageLog[]
  appointment         Appointment?
  productLines        VisitProduct[]
  stockMovements      StockMovement[]

  @@unique([barberId, idempotencyKey])
  @@unique([salonId, invoiceNumber])
  @@index([organizationId, visitedAt])
  @@index([organizationId, status, visitedAt])
  @@index([salonId, visitedAt])
  @@index([salonId, status, visitedAt])
  @@index([visitedAt])
  @@index([barberId, visitedAt])
  @@index([customerId, visitedAt])
  @@index([status])
  @@index([cancelledByUserId])
  @@index([cashSessionId])
}

model VisitService {
  id               String  @id @default(cuid())
  visitId          String
  serviceId        String
  serviceName      String
  unitPrice        Decimal @db.Decimal(10, 2)
  quantity         Int     @default(1)
  lineTotal        Decimal @db.Decimal(10, 2)
  commissionRate   Decimal @default(0) @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @db.Decimal(10, 2)
  visit            Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  service          Service @relation(fields: [serviceId], references: [id])

  @@index([visitId])
  @@index([serviceId])
}

model LoyaltyAccount {
  id               String       @id @default(cuid())
  organizationId   String
  customerId       String       @unique
  points           Int          @default(0)
  lifetimeEarned   Int          @default(0)
  lifetimeRedeemed Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, points])
}

model LoyaltyTransaction {
  id             String                 @id @default(cuid())
  organizationId String
  customerId     String
  visitId        String?
  type           LoyaltyTransactionType
  points         Int
  balanceAfter   Int
  description    String?
  createdAt      DateTime               @default(now())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer               @relation(fields: [customerId], references: [id])
  visit          Visit?                 @relation(fields: [visitId], references: [id])

  @@index([customerId, createdAt])
  @@index([visitId])
  @@index([type])
  @@index([organizationId])
}

model RewardRule {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  requiredPoints Int
  discountAmount Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@unique([organizationId, requiredPoints])
  @@index([organizationId, isActive, requiredPoints])
}

model Campaign {
  id                 String               @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  discountType       CampaignDiscountType
  discountValue      Decimal              @db.Decimal(10, 2)
  targetType         CampaignTargetType
  inactiveDays       Int?
  minPoints          Int?
  startAt            DateTime
  endAt              DateTime
  maxUsesPerCustomer Int                  @default(1)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions        CampaignRedemption[]
  whatsappMessages   WhatsAppMessageLog[]

  @@index([organizationId, isActive, startAt, endAt])
  @@index([targetType])
}

model CampaignRedemption {
  id             String       @id @default(cuid())
  organizationId String
  campaignId     String
  customerId     String
  visitId        String       @unique
  discountAmount Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign     @relation(fields: [campaignId], references: [id])
  customer       Customer     @relation(fields: [customerId], references: [id])
  visit          Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([campaignId, customerId])
  @@index([customerId, createdAt])
  @@index([organizationId])
}

model ManagerReward {
  id              String       @id @default(cuid())
  organizationId  String
  customerId      String
  issuedByUserId  String
  redeemedVisitId String?      @unique
  title           String
  description     String?
  discountAmount  Decimal      @db.Decimal(10, 2)
  expiresAt       DateTime?
  redeemedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  issuedBy        User         @relation("ManagerRewardIssuedBy", fields: [issuedByUserId], references: [id])
  redeemedVisit   Visit?       @relation(fields: [redeemedVisitId], references: [id])

  @@index([customerId, redeemedAt, revokedAt, expiresAt])
  @@index([issuedByUserId, createdAt])
  @@index([redeemedVisitId])
  @@index([organizationId])
}

model DailyClose {
  id                       String       @id @default(cuid())
  organizationId           String
  salonId                  String
  barberId                 String
  date                     DateTime
  visitsCount              Int          @default(0)
  grossTotal               Decimal      @default(0) @db.Decimal(12, 2)
  discountTotal            Decimal      @default(0) @db.Decimal(12, 2)
  netTotal                 Decimal      @default(0) @db.Decimal(12, 2)
  cashTotal                Decimal      @default(0) @db.Decimal(12, 2)
  cardTotal                Decimal      @default(0) @db.Decimal(12, 2)
  pointsEarnedTotal        Int          @default(0)
  pointsRedeemedTotal      Int          @default(0)
  rewardRedemptionsCount   Int          @default(0)
  campaignRedemptionsCount Int          @default(0)
  cashReceivedAmount       Decimal      @default(0) @db.Decimal(12, 2)
  receivedByUserId         String
  receivedAt               DateTime     @default(now())
  notes                    String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon                    Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber                   Barber       @relation(fields: [barberId], references: [id])
  receivedBy               User         @relation("DailyCloseReceivedBy", fields: [receivedByUserId], references: [id])

  @@unique([barberId, date])
  @@index([organizationId, date])
  @@index([salonId, date])
  @@index([date])
  @@index([receivedByUserId])
}

model CashSession {
  id                       String            @id @default(cuid())
  organizationId           String
  salonId                  String
  barberId                 String
  status                   CashSessionStatus @default(OPEN)
  openedAt                 DateTime          @default(now())
  // عهدة بداية الدرج؛ تدخل في المطابقة ولا تُعد إيرادًا.
  openingCashAmount        Decimal           @default(0) @db.Decimal(12, 2)
  closedAt                 DateTime?
  closedByUserId           String?
  visitsCount              Int               @default(0)
  grossTotal               Decimal           @default(0) @db.Decimal(12, 2)
  discountTotal            Decimal           @default(0) @db.Decimal(12, 2)
  netTotal                 Decimal           @default(0) @db.Decimal(12, 2)
  cashTotal                Decimal           @default(0) @db.Decimal(12, 2)
  cardTotal                Decimal           @default(0) @db.Decimal(12, 2)
  pointsEarnedTotal        Int               @default(0)
  pointsRedeemedTotal      Int               @default(0)
  rewardRedemptionsCount   Int               @default(0)
  campaignRedemptionsCount Int               @default(0)
  cashReceivedAmount       Decimal?          @db.Decimal(12, 2)
  // مصروفات نثرية خرجت من الدرج خلال الجلسة — تُخصم من الكاش المتوقع.
  expensesTotal            Decimal           @default(0) @db.Decimal(12, 2)
  notes                    String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon                    Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber                   Barber            @relation(fields: [barberId], references: [id])
  closedBy                 User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  visits                   Visit[]
  expenses                 CashExpense[]
  cashCollections          CashCollection[]
  // تحويلات التحصيل التي خرجت من الدرج أثناء الجلسة؛ لا تُعد إيرادًا ولا مصروفًا.
  collectionsTotal         Decimal           @default(0) @db.Decimal(12, 2)

  @@index([organizationId, status])
  @@index([organizationId, status, closedAt])
  @@index([salonId, status])
  @@index([salonId, status, closedAt])
  @@index([barberId, status])
  @@index([openedAt])
  @@index([closedAt])
  @@index([closedByUserId])
}

model SystemSettings {
  id                            String       @id @default(cuid())
  organizationId                String
  salonId                       String?      @unique
  singletonKey                  String?
  salonName                     String
  currency                      String       @default("SAR")
  pointsPerCurrencyUnit         Decimal      @default(1) @db.Decimal(8, 2)
  pointsCalculatedAfterDiscount Boolean      @default(true)
  allowMultipleDiscounts        Boolean      @default(false)
  whatsappDefaultCountryCode    String       @default("966")
  whatsappEnabled               Boolean      @default(true)
  // الاسم الذي يظهر في هوية الصالون والإيصالات التشغيلية.
  legalName                     String?
  // نسبة العمولة الافتراضية للفرع %. تُستخدم إن لم تُحدَّد للحلاق أو الخدمة.
  defaultCommissionRate         Decimal      @default(0) @db.Decimal(5, 2)
  // الحجز الذاتي من بوابة العميل — معطّل افتراضيًا حتى يفعّله المالك صراحةً.
  // تعطيله يعيد سلوك النظام السابق حرفيًا: الحجز من الموظفين فقط.
  bookingEnabled                Boolean      @default(false)
  // ساعات استقبال الحجز كدقائق من منتصف الليل (0..1439) بتوقيت الصالون المحلي.
  // دقائق لا نص: تُقارن وتُولَّد حسابيًا بلا تحليل نصوص في كل فترة.
  bookingOpenMinute             Int          @default(960)
  bookingCloseMinute            Int          @default(1380)
  // طول الفترة المعروضة للعميل بالدقائق (هي أيضًا مدة الموعد الافتراضية).
  bookingSlotMinutes            Int          @default(30)
  // أيام الإغلاق الأسبوعية: 0=الأحد .. 6=السبت.
  bookingClosedWeekdays         Int[]        @default([])
  // أقل مهلة بين الآن وبداية الموعد — تمنع حجزًا بعد دقيقتين والحلاق على الكرسي.
  bookingLeadMinutes            Int          @default(120)
  // مدى الحجز المستقبلي بالأيام.
  bookingHorizonDays            Int          @default(14)
  // أقصى عدد مواعيد قائمة للعميل الواحد — يمنع حجز مقاعد وهمية.
  bookingMaxActivePerCustomer   Int          @default(2)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon                         Salon?       @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// عدّاد تسلسلي للفواتير لكل فرع لكل سنة. يُزاد داخل معاملة تأكيد الزيارة.
model InvoiceCounter {
  id             String   @id @default(cuid())
  organizationId String
  salonId        String
  year           Int
  lastNumber     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([salonId, year])
  @@index([organizationId])
}

model WhatsAppTemplate {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  type           WhatsAppTemplateType
  body           String
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       WhatsAppMessageLog[]

  @@index([organizationId, type, isActive])
}

model WhatsAppMessageLog {
  id                 String                  @id @default(cuid())
  organizationId     String
  customerId         String
  templateId         String?
  campaignId         String?
  visitId            String?
  phone              String
  message            String
  waUrl              String
  status             WhatsAppMessageStatus   @default(DRAFTED)
  category           WhatsAppMessageCategory @default(SERVICE)
  policySnapshot     Json?
  openedByUserId     String?
  openedAt           DateTime?
  markedSentByUserId String?
  markedSentAt       DateTime?
  skippedReason      String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template           WhatsAppTemplate?       @relation(fields: [templateId], references: [id])
  campaign           Campaign?               @relation(fields: [campaignId], references: [id])
  visit              Visit?                  @relation(fields: [visitId], references: [id])
  openedBy           User?                   @relation("WhatsAppOpenedBy", fields: [openedByUserId], references: [id])
  markedSentBy       User?                   @relation("WhatsAppMarkedSentBy", fields: [markedSentByUserId], references: [id])

  @@index([customerId, createdAt])
  @@index([organizationId, category, createdAt])
  @@index([templateId])
  @@index([campaignId])
  @@index([visitId])
  @@index([status, createdAt])
  @@index([openedByUserId])
  @@index([markedSentByUserId])
  @@index([organizationId])
}

model WhatsAppSafetySettings {
  id                            String             @id @default(cuid())
  organizationId                String             @unique
  mode                          WhatsAppSafetyMode @default(STRICT)
  marketingCooldownHours        Int                @default(168)
  maxMarketingPerCustomer30Days Int                @default(4)
  maxMessagesPerCustomer24Hours Int                @default(2)
  dailyOrganizationDraftLimit   Int                @default(100)
  appendOptOutInstructions      Boolean            @default(true)
  optOutText                    String             @default("لإيقاف العروض اكتب إيقاف")
  marketingPaused               Boolean            @default(false)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  organization                  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([mode])
}

// مصروف نثري من درج الكاش. يُخصم من الكاش المتوقع عند إغلاق الجلسة
// حتى يصبح فرق الصندوق قابلًا للتفسير بدل أن يظهر كعجز.
model CashExpense {
  id                 String               @id @default(cuid())
  organizationId     String
  salonId            String
  cashSessionId      String?
  barberId           String?
  amount             Decimal              @db.Decimal(10, 2)
  category           ExpenseCategory      @default(OTHER)
  paymentSource      ExpensePaymentSource @default(CASH_DRAWER)
  note               String
  payee              String?
  reference          String?
  recordedByUserId   String?
  recordedByBarberId String?
  // تاريخ استحقاق/حدوث المصروف مستقل عن وقت إدخاله للنظام.
  expenseDate        DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  barber       Barber?      @relation("CashExpenseBarber", fields: [barberId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, expenseDate])
  @@index([salonId, createdAt])
  @@index([salonId, expenseDate])
  @@index([cashSessionId])
  @@index([barberId])
  @@index([organizationId, paymentSource, createdAt])
}

// رصيد العهدة الفعلي لدى الحلاق. يبدأ غير مهيأ حتى يثبّت المدير أول عدّ فعلي،
// حتى لا نستنتج أرصدة تاريخية قد تكون حُصّلت خارج النظام.
model BarberCashBalance {
  barberId       String    @id
  organizationId String
  salonId        String
  balance        Decimal   @default(0) @db.Decimal(12, 2)
  isInitialized  Boolean   @default(false)
  initializedAt  DateTime?
  lastMovementAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([organizationId, salonId])
  @@index([salonId, isInitialized])
}

// خزنة الفرع مستقلة عن الإيراد؛ التحصيل يزيدها والسحب للمالك/البنك ينقصها.
model BranchCashSafe {
  salonId        String    @id
  organizationId String
  balance        Decimal   @default(0) @db.Decimal(12, 2)
  lastMovementAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// دفتر أستاذ غير قابل للتعديل: كل تغير يُسجل كحركة جديدة مع الرصيد قبلها وبعدها.
model CashCustodyMovement {
  id                  String                  @id @default(cuid())
  organizationId      String
  salonId             String
  barberId            String?
  cashSessionId       String?
  type                CashCustodyMovementType
  amount              Decimal                 @db.Decimal(12, 2)
  barberDelta         Decimal                 @default(0) @db.Decimal(12, 2)
  branchDelta         Decimal                 @default(0) @db.Decimal(12, 2)
  barberBalanceBefore Decimal?                @db.Decimal(12, 2)
  barberBalanceAfter  Decimal?                @db.Decimal(12, 2)
  branchBalanceBefore Decimal?                @db.Decimal(12, 2)
  branchBalanceAfter  Decimal?                @db.Decimal(12, 2)
  referenceKey        String                  @unique
  referenceId         String?
  note                String?
  actorType           AuditActorType
  actorUserId         String?
  actorBarberId       String?
  occurredAt          DateTime                @default(now())
  createdAt           DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([salonId, occurredAt])
  @@index([barberId, occurredAt])
  @@index([cashSessionId])
  @@index([referenceId])
}

// إيصال تحصيل: يثبت العد، المبلغ المستلم، والمتبقي لدى الحلاق. لا يُعدل؛ الخطأ يُعكس.
model CashCollection {
  id                String    @id @default(cuid())
  organizationId    String
  salonId           String
  barberId          String
  cashSessionId     String?
  collectedByUserId String
  expectedBefore    Decimal   @db.Decimal(12, 2)
  countedAmount     Decimal   @db.Decimal(12, 2)
  discrepancyAmount Decimal   @default(0) @db.Decimal(12, 2)
  discrepancyReason String?
  collectedAmount   Decimal   @db.Decimal(12, 2)
  remainingAfter    Decimal   @db.Decimal(12, 2)
  branchSafeAfter   Decimal   @db.Decimal(12, 2)
  note              String?
  idempotencyKey    String
  collectedAt       DateTime  @default(now())
  reversedAt        DateTime?
  reversedByUserId  String?
  reversalReason    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id])
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  collectedBy  User         @relation("CashCollectionCollectedBy", fields: [collectedByUserId], references: [id])
  reversedBy   User?        @relation("CashCollectionReversedBy", fields: [reversedByUserId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([salonId, collectedAt])
  @@index([barberId, collectedAt])
  @@index([cashSessionId])
  @@index([reversedAt])
}

// تذكير اختياري فقط؛ لا ينشئ أي حركة مالية تلقائيًا.
model CashCollectionPolicy {
  salonId         String                     @id
  organizationId  String
  mode            CashCollectionScheduleMode @default(DISABLED)
  intervalDays    Int                        @default(1)
  weekdays        Int[]                      @default([])
  thresholdAmount Decimal?                   @db.Decimal(12, 2)
  reminderHour    Int                        @default(17)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// موعد حجز. الصالون walk-in أصلًا، فالموعد اختياري ولا يمنع تسجيل زيارة بدونه.
model Appointment {
  id              String            @id @default(cuid())
  organizationId  String
  salonId         String
  barberId        String?
  customerId      String?
  customerName    String
  customerPhone   String
  startAt         DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(BOOKED)
  source          AppointmentSource @default(STAFF)
  notes           String?
  // الزيارة الناتجة عن الموعد عند وصول العميل وإتمام الخدمة.
  visitId         String?           @unique
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visit        Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([salonId, startAt])
  @@index([organizationId, startAt])
  @@index([organizationId, salonId, status, startAt])
  @@index([barberId, startAt])
  @@index([status, startAt])
  @@index([customerId])
}

// منتج للبيع (شمع، شامبو...). المخزون رقم صحيح بسيط — لا دفعات ولا صلاحيات.
model Product {
  id                String   @id @default(cuid())
  organizationId    String
  salonId           String
  name              String
  sku               String?
  price             Decimal  @db.Decimal(10, 2)
  costPrice         Decimal? @db.Decimal(10, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(3)
  commissionRate    Decimal? @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon         Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  visitProducts VisitProduct[]
  movements     StockMovement[]

  @@unique([salonId, name])
  @@index([salonId, isActive, sortOrder])
  @@index([organizationId])
}

// سطر منتج مباع ضمن زيارة — نسخة من الاسم والسعر وقت البيع.
model VisitProduct {
  id               String  @id @default(cuid())
  visitId          String
  productId        String
  productName      String
  unitPrice        Decimal @db.Decimal(10, 2)
  quantity         Int     @default(1)
  lineTotal        Decimal @db.Decimal(10, 2)
  commissionRate   Decimal @default(0) @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @db.Decimal(10, 2)

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([visitId])
  @@index([productId])
}

// حركة مخزون. كل تغيير في الكمية يمرّ من هنا — المخزون قابل للتدقيق لا رقم يُكتب فوقه.
model StockMovement {
  id                 String            @id @default(cuid())
  organizationId     String
  salonId            String
  productId          String
  type               StockMovementType
  quantity           Int
  balanceAfter       Int
  reason             String?
  visitId            String?
  recordedByUserId   String?
  recordedByBarberId String?
  createdAt          DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  visit        Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([salonId, createdAt])
  @@index([organizationId, createdAt])
  @@index([visitId])
}

// حضور وانصراف الحلاق. سجل مستقل عن جلسة الصندوق: الجلسة أداة مالية والحضور أداة إدارية.
model AttendanceRecord {
  id             String           @id @default(cuid())
  organizationId String
  salonId        String
  barberId       String
  checkInAt      DateTime         @default(now())
  checkOutAt     DateTime?
  source         AttendanceSource @default(SELF)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, checkInAt])
  @@index([salonId, checkInAt])
  @@index([organizationId, checkInAt])
}

// فاتورة اشتراك المؤسسة في المنصّة (مقابل فاتورة الزيارة للعميل).
// مصدر الحقيقة لما دُفع فعلًا؛ حالة الاشتراك على `Organization` مشتقّة منها.
model BillingInvoice {
  id                        String               @id @default(cuid())
  organizationId            String
  planId                    String?
  provider                  PaymentProvider      @default(MANUAL_TRANSFER)
  status                    BillingInvoiceStatus @default(PAID)
  // بالريال. يُخزَّن كما حُصِّل فعلًا لا كما هو في الباقة اليوم.
  amount                    Decimal              @db.Decimal(10, 2)
  currency                  String               @default("SAR")
  // رقم فاتورة اشتراك XMANSX؛ يصدر عند اعتماد الدفعة ويظل ثابتًا.
  invoiceNumber             String?              @unique
  issuedAt                  DateTime?
  sellerName                String?
  sellerFreelanceDocument   String?
  sellerActivity            String?
  buyerName                 String?
  buyerCity                 String?
  periodMonths              Int                  @default(1)
  // مرجع العملية (رقم الحوالة/الإيصال) — فريد لمنع تسجيل الدفعة مرتين.
  reference                 String?              @unique
  note                      String?
  paidAt                    DateTime?
  periodStart               DateTime?
  periodEnd                 DateTime?
  // مدير المنصة الذي سجّل الدفعة — الفوترة من اختصاصه لا اختصاص المستأجر.
  recordedByPlatformAdminId String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([planId])
}

model BillingInvoiceCounter {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DataSubjectRequest {
  id                         String                   @id @default(cuid())
  organizationId             String
  customerId                 String?
  type                       DataSubjectRequestType
  status                     DataSubjectRequestStatus @default(OPEN)
  details                    String?
  requestedName              String?
  requestedPhone             String?
  identityVerifiedAt         DateTime?
  identityVerificationMethod String?
  executedAt                 DateTime?
  resolutionNote             String?
  resolvedAt                 DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([customerId, createdAt])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String?
  salonId        String?
  actorType      AuditActorType
  actorUserId    String?
  actorBarberId  String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?          @relation(fields: [actorUserId], references: [id])
  actorBarber    Barber?        @relation("BarberAuditLogs", fields: [actorBarberId], references: [id])

  @@index([createdAt])
  @@index([actorType, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}
