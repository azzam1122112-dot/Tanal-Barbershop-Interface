generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SUPERVISOR
  BARBER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentMethod {
  CASH
  NETWORK
}

enum VisitStatus {
  COMPLETED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashCustodyMovementType {
  OPENING_BALANCE
  CASH_SALE
  CASH_EXPENSE
  COLLECTION
  COLLECTION_REVERSAL
  VISIT_REVERSAL
  PAYMENT_METHOD_ADJUSTMENT
  VISIT_AMOUNT_ADJUSTMENT
  EXPENSE_REVERSAL
  COUNT_ADJUSTMENT
  SAFE_OWNER_PICKUP
  SAFE_BANK_DEPOSIT
  // صرف عمولة: من خزنة الفرع نقدًا، أو خصمًا مما بيد الحلاق من عهدة.
  SAFE_COMMISSION_PAYOUT
  CUSTODY_COMMISSION_PAYOUT
  CUSTODY_COMMISSION_PAYOUT_REVERSAL
  SAFE_COMMISSION_PAYOUT_REVERSAL
}

enum CashCollectionScheduleMode {
  DISABLED
  INTERVAL
  WEEKDAYS
}

enum DiscountType {
  NONE
  REWARD
  CAMPAIGN
  MANAGER_REWARD
}

enum CampaignDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum CampaignTargetType {
  ALL_CUSTOMERS
  NEW_CUSTOMERS
  INACTIVE_CUSTOMERS
  CUSTOMERS_WITH_MIN_POINTS
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REVERSAL
}

enum AuditActorType {
  PLATFORM_ADMIN
  OWNER
  ADMIN
  SUPERVISOR
  BARBER
  // العميل نفسه من بوابته (حجز أو إلغاء موعد). فاعل حقيقي بلا حساب في النظام،
  // فلا يصح وسمه SYSTEM وإلا ضاع الفرق بين فعل العميل وفعل آلي.
  CUSTOMER
  SYSTEM
}

enum WhatsAppTemplateType {
  POST_VISIT
  REWARD_READY
  CAMPAIGN
  INACTIVE_CUSTOMER
  CUSTOM
}

enum WhatsAppMessageStatus {
  DRAFTED
  OPENED
  MARKED_SENT
  SKIPPED
  FAILED
}

enum WhatsAppMessageCategory {
  TRANSACTIONAL
  MARKETING
  SERVICE
}

enum WhatsAppConsentSource {
  IN_PERSON
  WEBSITE
  WHATSAPP
  PHONE
  IMPORTED
  OTHER
}

enum WhatsAppSafetyMode {
  STRICT
  BALANCED
  CUSTOM
}

enum ExpenseCategory {
  SUPPLIES
  MAINTENANCE
  UTILITIES
  REFUND
  OTHER
}

enum ExpensePaymentSource {
  CASH_DRAWER
  EXTERNAL
}

/**
 * طريقة صرف العمولة — كل قيمة أثرها مختلف على دفاتر النقد.
 */
enum CommissionPayoutMethod {
  // حوالة أو محفظة: لا أثر على أي دفتر نقدي داخل النظام.
  BANK_TRANSFER
  // نقدًا من خزنة الفرع: تنقص الخزنة بحركة موثقة.
  CASH_FROM_SAFE
  // يبقي الحلاق ما يعادلها مما بيده: تنقص عهدته بدل أن يسلّمها ويستلمها.
  BARBER_CUSTODY_DEDUCTION
  // تسوية افتتاحية لمرة واحدة: اعتماد ما قبل التشغيل مدفوعًا بلا حركة نقد.
  OPENING_SETTLEMENT
}

enum AppointmentStatus {
  BOOKED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  STAFF
  CUSTOMER
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
  RETURN
}

enum AttendanceSource {
  SELF
  MANAGER
}

// طريقة تحصيل الاشتراك. حاليًا يدوي (تحويل بنكي/نقدًا) يسجّله مدير المنصة.
// إضافة بوابة لاحقًا = قيمة جديدة هنا + محوّل يكتب نفس `BillingInvoice`.
enum PaymentProvider {
  MANUAL_TRANSFER
  MANUAL_CASH
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum DataSubjectRequestType {
  ACCESS
  COPY
  CORRECTION
  DELETION
  WITHDRAW_CONSENT
}

enum DataSubjectRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum PlatformSupportStatus {
  OPEN
  PENDING
  RESOLVED
  SPAM
}

enum PlatformSupportPriority {
  NORMAL
  HIGH
  URGENT
}

enum PlatformSupportDirection {
  INBOUND
  OUTBOUND
}

// ===== Platform / Tenancy =====

// مدير المنصة (super-admin) — يدير كل المؤسسات والباقات. خارج أي مستأجر.
model PlatformAdmin {
  id                    String                        @id @default(cuid())
  name                  String
  email                 String                        @unique
  passwordHash          String
  isActive              Boolean                       @default(true)
  mfaEnabledAt          DateTime?
  mfaSecretCiphertext   String?
  mfaPendingCiphertext  String?
  mfaRecoveryCodeHashes String[]                      @default([])
  mfaLastUsedStep       BigInt?
  lastLoginAt           DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  sessions              Session[]
  mfaChallenges         PlatformMfaChallenge[]
  assignedSupport       PlatformSupportConversation[] @relation("PlatformSupportAssignedAdmin")
  sentSupportMessages   PlatformSupportMessage[]      @relation("PlatformSupportSentByAdmin")
}

model PlatformMfaChallenge {
  id              String        @id @default(cuid())
  tokenHash       String        @unique
  platformAdminId String
  expiresAt       DateTime
  attempts        Int           @default(0)
  consumedAt      DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId, expiresAt])
  @@index([expiresAt, consumedAt])
}

// صندوق دعم المنصة مستقل عن بيانات المؤسسات التشغيلية. الرسائل هنا موجهة إلى
// إدارة XMANSX نفسها، ولا تُعرض لأي مالك أو مدير مؤسسة.
model PlatformSupportConversation {
  id               String                  @id @default(cuid())
  participantEmail String
  participantName  String?
  subject          String
  subjectKey       String
  status           PlatformSupportStatus   @default(OPEN)
  priority         PlatformSupportPriority @default(NORMAL)
  unreadCount      Int                     @default(0)
  lastMessageAt    DateTime
  assignedAdminId  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  assignedAdmin PlatformAdmin?           @relation("PlatformSupportAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      PlatformSupportMessage[]

  @@index([status, lastMessageAt])
  @@index([participantEmail, subjectKey, lastMessageAt])
  @@index([assignedAdminId, status])
}

model PlatformSupportMessage {
  id              String                   @id @default(cuid())
  conversationId  String
  providerEmailId String?                  @unique
  providerEventId String?                  @unique
  direction       PlatformSupportDirection
  fromAddress     String
  toAddresses     String[]
  ccAddresses     String[]                 @default([])
  subject         String
  bodyText        String                   @db.Text
  messageId       String?
  inReplyTo       String?
  references      String[]                 @default([])
  sentByAdminId   String?
  createdAt       DateTime                 @default(now())

  conversation PlatformSupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByAdmin  PlatformAdmin?              @relation("PlatformSupportSentByAdmin", fields: [sentByAdminId], references: [id], onDelete: SetNull)
  attachments  PlatformSupportAttachment[]

  @@index([conversationId, createdAt])
  @@index([messageId])
  @@index([sentByAdminId, createdAt])
}

model PlatformSupportAttachment {
  id                   String   @id @default(cuid())
  messageId            String
  providerAttachmentId String
  filename             String
  contentType          String
  contentDisposition   String?
  contentId            String?
  size                 Int?
  createdAt            DateTime @default(now())

  message PlatformSupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, providerAttachmentId])
  @@index([messageId])
}

// الباقة هي مصدر الحقيقة للوحة المنصة وصفحة الهبوط وصفحة اشتراك المؤسسة.
model Plan {
  id              String           @id @default(cuid())
  name            String           @unique
  slug            String           @unique
  description     String?
  priceMonthly    Decimal          @default(0) @db.Decimal(10, 2)
  priceYearly     Decimal?         @db.Decimal(10, 2)
  features        String[]         @default([])
  maxSalons       Int              @default(1)
  maxBarbers      Int? // null = غير محدود
  maxCustomers    Int?
  isActive        Boolean          @default(true)
  isPublic        Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  isSignupDefault Boolean          @default(false)
  // مدة التجربة التي يحصل عليها التسجيل الذاتي عند جعل الباقة افتراضية.
  trialDays       Int              @default(14)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizations   Organization[]
  billingInvoices BillingInvoice[]

  @@index([isActive, isPublic, sortOrder])
}

// المؤسسة (المالك) — حدّ العزل الأساسي + العميل/الولاء + الفوترة.
model Organization {
  id                     String             @id @default(cuid())
  name                   String
  city                   String?
  slug                   String             @unique // النطاق الفرعي
  status                 OrganizationStatus @default(ACTIVE)
  planId                 String?
  subscriptionStatus     SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  // يبدأ عند توقف التجربة/الاشتراك فعليًا. بعد 60 يومًا تحذف الصيانة الحساب وبياناته.
  inactiveSince          DateTime?
  termsAcceptedAt        DateTime?
  termsVersion           String?
  privacyAcceptedAt      DateTime?
  privacyVersion         String?
  dpaAcceptedAt          DateTime?
  dpaVersion             String?
  legalAcceptedIp        String?
  legalAcceptedUserAgent String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  plan                    Plan?                    @relation(fields: [planId], references: [id])
  salons                  Salon[]
  users                   User[]
  barbers                 Barber[]
  customers               Customer[]
  services                Service[]
  visits                  Visit[]
  loyaltyAccounts         LoyaltyAccount[]
  loyaltyTransactions     LoyaltyTransaction[]
  rewardRules             RewardRule[]
  campaigns               Campaign[]
  campaignRedemptions     CampaignRedemption[]
  managerRewards          ManagerReward[]
  dailyCloses             DailyClose[]
  cashSessions            CashSession[]
  systemSettings          SystemSettings[]
  whatsappTemplates       WhatsAppTemplate[]
  whatsappMessages        WhatsAppMessageLog[]
  whatsappSafetySettings  WhatsAppSafetySettings?
  auditLogs               AuditLog[]
  sessions                Session[]
  staffSalons             StaffSalon[]
  cashExpenses            CashExpense[]
  barberCashBalances      BarberCashBalance[]
  branchCashSafes         BranchCashSafe[]
  cashCustodyMovements    CashCustodyMovement[]
  cashCollections         CashCollection[]
  commissionPayouts       CommissionPayout[]
  cashCollectionPolicies  CashCollectionPolicy[]
  appointments            Appointment[]
  products                Product[]
  stockMovements          StockMovement[]
  attendance              AttendanceRecord[]
  billingInvoices         BillingInvoice[]
  barberPushSubscriptions BarberPushSubscription[]
  dataSubjectRequests     DataSubjectRequest[]

  @@index([status])
  @@index([planId])
  @@index([subscriptionStatus, inactiveSince])
}

// الصالون — الوحدة التشغيلية داخل المؤسسة.
model Salon {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barbers              Barber[]
  services             Service[]
  visits               Visit[]
  cashSessions         CashSession[]
  dailyCloses          DailyClose[]
  settings             SystemSettings?
  sessions             Session[]
  staffAssignments     StaffSalon[]
  cashExpenses         CashExpense[]
  barberCashBalances   BarberCashBalance[]
  branchCashSafe       BranchCashSafe?
  cashCustodyMovements CashCustodyMovement[]
  cashCollections      CashCollection[]
  commissionPayouts    CommissionPayout[]
  cashCollectionPolicy CashCollectionPolicy?
  appointments         Appointment[]
  products             Product[]
  stockMovements       StockMovement[]
  attendance           AttendanceRecord[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
}

// إسناد مشرف (User بدور SUPERVISOR) إلى فرع محدد. مشرف واحد يمكن إسناده لعدة فروع.
// المالك والمدير على مستوى المؤسسة دائمًا فلا يحتاجان إسنادًا هنا.
model StaffSalon {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  salonId        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([userId, salonId])
  @@index([salonId])
  @@index([organizationId])
}

// ===== Tenant data =====

model User {
  id                         String               @id @default(cuid())
  organizationId             String
  name                       String
  email                      String?
  phone                      String
  passwordHash               String
  role                       UserRole             @default(ADMIN)
  isActive                   Boolean              @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  organization               Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs                  AuditLog[]
  sessions                   Session[]
  dailyCloses                DailyClose[]         @relation("DailyCloseReceivedBy")
  closedCashSessions         CashSession[]        @relation("CashSessionClosedBy")
  cancelledVisits            Visit[]              @relation("VisitCancelledBy")
  openedWhatsAppMessages     WhatsAppMessageLog[] @relation("WhatsAppOpenedBy")
  markedSentWhatsAppMessages WhatsAppMessageLog[] @relation("WhatsAppMarkedSentBy")
  issuedManagerRewards       ManagerReward[]      @relation("ManagerRewardIssuedBy")
  salonAssignments           StaffSalon[]
  collectedCash              CashCollection[]     @relation("CashCollectionCollectedBy")
  reversedCashCollections    CashCollection[]     @relation("CashCollectionReversedBy")
  paidCommissions            CommissionPayout[]   @relation("CommissionPayoutPaidBy")
  reversedCommissionPayouts  CommissionPayout[]   @relation("CommissionPayoutReversedBy")

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([organizationId, role, isActive])
}

model Barber {
  id                   String                   @id @default(cuid())
  organizationId       String
  salonId              String
  name                 String
  phone                String
  accessPinHash        String
  role                 UserRole                 @default(BARBER)
  isActive             Boolean                  @default(true)
  // بوابة صريحة لحساب العمولة وإظهار مستحقاتها للحلاق.
  commissionEnabled    Boolean                  @default(false)
  // نسبة عمولة الحلاق %. null = استخدم النسبة الافتراضية للفرع.
  commissionRate       Decimal?                 @db.Decimal(5, 2)
  // دوام الحلاق للحجز الذاتي. عند التعطيل يرث دوام الفرع وإجازاته.
  workScheduleEnabled  Boolean                  @default(false)
  workStartMinute      Int                      @default(960)
  workEndMinute        Int                      @default(1380)
  workClosedWeekdays   Int[]                    @default([])
  lastLoginAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon                Salon                    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdCustomers     Customer[]               @relation("CustomerCreatedByBarber")
  visits               Visit[]
  auditLogs            AuditLog[]               @relation("BarberAuditLogs")
  sessions             Session[]
  dailyCloses          DailyClose[]
  cashSessions         CashSession[]
  expenses             CashExpense[]            @relation("CashExpenseBarber")
  appointments         Appointment[]
  attendance           AttendanceRecord[]
  pushSubscriptions    BarberPushSubscription[]
  cashBalance          BarberCashBalance?
  cashCustodyMovements CashCustodyMovement[]
  cashCollections      CashCollection[]
  commissionPayouts    CommissionPayout[]

  @@unique([organizationId, phone])
  @@index([salonId, isActive])
  @@index([organizationId])
}

model Session {
  id                     String                  @id @default(cuid())
  tokenHash              String                  @unique
  actorType              AuditActorType
  organizationId         String?
  activeSalonId          String?
  userId                 String?
  barberId               String?
  platformAdminId        String?
  role                   UserRole?
  createdAt              DateTime                @default(now())
  expiresAt              DateTime
  lastUsedAt             DateTime?
  revokedAt              DateTime?
  mfaVerifiedAt          DateTime?
  mfaSetupOnly           Boolean                 @default(false)
  userAgent              String?
  ipAddress              String?
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  barber                 Barber?                 @relation(fields: [barberId], references: [id], onDelete: Cascade)
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeSalon            Salon?                  @relation(fields: [activeSalonId], references: [id], onDelete: SetNull)
  platformAdmin          PlatformAdmin?          @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  barberPushSubscription BarberPushSubscription?

  @@index([tokenHash])
  @@index([userId, revokedAt])
  @@index([barberId, revokedAt])
  @@index([expiresAt])
  @@index([organizationId])
  @@index([platformAdminId])
}

// اشتراك Web Push مرتبط بجلسة حلاق بعينها. مسار الخروج يحذفه في نفس معاملة
// إلغاء الجلسة، بينما يسمح للحلاق بأكثر من جهاز عبر جلسة مستقلة لكل جهاز.
model BarberPushSubscription {
  id             String    @id @default(cuid())
  organizationId String
  barberId       String
  sessionId      String    @unique
  endpoint       String    @unique
  p256dh         String
  auth           String
  userAgent      String?
  lastSuccessAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([barberId, updatedAt])
  @@index([organizationId])
}

/**
 * هوية الشخص على مستوى منصة XMANSX كلها — **ليست كيان مستأجر**.
 * لا تحمل `organizationId` ولا `salonId` ولا قيد مستأجرين مركّبًا، ولا تُربط بها
 * أي بيانات تشغيلية: الزيارات والمواعيد والنقاط تبقى كلها على `Customer` المملوك
 * لمؤسسته. دورها الوحيد أن تجمع سجلات العميل عبر المؤسسات تحت شخص واحد لتسجيل
 * دخول موحّد لاحقًا.
 * **قاعدة أمنية دائمة:** ممنوع في أي كود تخدمه مؤسسة (لوحة، API حلاق، بوابة)
 * أن يعبر `Customer → account → customers` — العبور يكشف لموظفي مؤسسة أن عميلهم
 * زبون عند منافس. الحارس آلي في `.semgrep.yml` (`xmansx-no-cross-tenant-account-traversal`).
 * **لا تُنشأ تلقائيًا:** لا عند فتح صفحة، ولا بمطابقة جوال، ولا بتعبئة رجعية.
 * إنشاؤها فعل صريح في مرحلة التسجيل/المطالبة القادمة.
 */
model CustomerAccount {
  id String @id @default(cuid())

  name            String
  /**
   * **بيانات تواصل غير موثوقة**، بالشكل المعياري `+9665XXXXXXXX`.
   * غير فريد عمدًا: من كتبه لم يثبت ملكيته، وحجزُ رقم بلا إثبات يمنع صاحبه
   * الحقيقي من التسجيل إلى الأبد (Phone Squatting / Denial of Registration).
   */
  phone           String
  /**
   * الرقم **المُثبَتة ملكيته** — `NULL` حتى يقع إثبات فعلي.
   *
   * التفرّد العالمي باقٍ كما هو ويسري على المُثبَت وحده، و`NULL` مميّز عن `NULL`
   * في PostgreSQL فلا يتزاحم أصحاب الأرقام غير المثبتة. **لا يوجد اليوم أي مسار
   * يملؤه** — يأتي مع المطالبة (PHASE C) أو تحقق SMS لاحقًا.
   */
  phoneNormalized String?               @unique
  /** لا يُكتب اليوم إطلاقًا. وجوده يمنع ادّعاء التوثيق ضمنًا من امتلاء الرقم. */
  phoneVerifiedAt DateTime?
  email           String?
  /**
   * بريد مصغَّر الحالة عبر `normalizeEmail`. NULL مسموح ومتعدد.
   */
  emailNormalized String?               @unique
  emailVerifiedAt DateTime?
  /**
   * يبقى فارغًا حتى مرحلة المصادقة — لا تُكتب فيه قيمة في هذه المرحلة.
   */
  passwordHash    String?
  status          CustomerAccountStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  customers  Customer[]
  challenges CustomerEmailChallenge[]
  sessions   CustomerSession[]

  @@index([status])
}

/**
 * تحدٍّ بريدي لمرة واحدة: تفعيل البريد أو استعادة كلمة المرور.
 * **الرمز لا يُخزَّن خامًا** — SHA-256 فقط، كرمز جلسة الموظف ورمز بوابة العميل.
 * قاعدة البيانات لا تعرف الرمز، فتسريبها لا يمنح دخولًا.
 * `purpose` يجعل الجدول واحدًا لغرضين بدل جدولين متطابقين، و`consumedAt`
 * يمنع إعادة الاستعمال، و`attemptCount` يحدّ التخمين على التحدي نفسه لا على
 * صاحبه فقط.
 * **اسمه `CustomerEmailChallenge` لا `EmailVerificationChallenge`** لأنه يخدم
 * الاستعادة أيضًا؛ اسم يذكر التفعيل وحده يغري بجدول ثانٍ لنفس البنية.
 */
model CustomerEmailChallenge {
  id                String                   @id @default(cuid())
  customerAccountId String
  purpose           CustomerChallengePurpose
  codeHash          String
  expiresAt         DateTime
  attemptCount      Int                      @default(0)
  consumedAt        DateTime?
  createdAt         DateTime                 @default(now())

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, purpose, createdAt])
  @@index([expiresAt])
}

enum CustomerChallengePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/**
 * جلسة العميل — **منفصلة تمامًا عن `Session`** الخاصة بالموظفين والمنصّة.
 * الفصل بنيوي لا تجميلي: جدول مستقل وكوكي باسم مستقل، فلا يوجد مسار يجعل جلسة
 * عميل تُقرأ حيث تُتوقَّع جلسة موظف. `middleware` يحرس مسارات الموظفين بوجود
 * `tanal_session` وحدها، وكوكي العميل باسم آخر فلا يفتح شيئًا منها.
 */
model CustomerSession {
  id                String    @id @default(cuid())
  customerAccountId String
  tokenHash         String    @unique
  expiresAt         DateTime
  lastUsedAt        DateTime  @default(now())
  revokedAt         DateTime?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, expiresAt])
  @@index([expiresAt])
}

/**
 * حالتان فقط عمدًا. «بانتظار التحقق» مشتقّة من `emailVerifiedAt IS NULL` ولا
 * يصح تكرارها كقيمة حالة: مصدران للحقيقة نفسها ينحرفان أول مرة يُحدَّث أحدهما.
 */
enum CustomerAccountStatus {
  ACTIVE
  DISABLED
}

model Customer {
  id                             String                 @id @default(cuid())
  organizationId                 String
  /**
   * الهوية العالمية لصاحب هذا السجل — اختيارية ودائمًا كذلك.
   * `NULL` هو وضع كل العملاء القدامى وليس حالة ناقصة تُصلَّح بتعبئة رجعية.
   */
  accountId                      String?
  name                           String
  phone                          String
  // المفتاح العام مشتق من وجود موافقة واحدة على الأقل، ويُبقى للتوافق مع الواجهات القديمة.
  whatsappOptIn                  Boolean                @default(false)
  whatsappTransactionalOptIn     Boolean                @default(false)
  whatsappMarketingOptIn         Boolean                @default(false)
  whatsappConsentSource          WhatsAppConsentSource?
  whatsappTransactionalConsentAt DateTime?
  whatsappMarketingConsentAt     DateTime?
  whatsappOptOutAt               DateTime?
  whatsappOptOutReason           String?
  whatsappLastContactedAt        DateTime?
  whatsappLastMarketingAt        DateTime?
  // لا يُخزّن رمز البوابة الصريح؛ SHA-256 فقط مع صلاحية محدودة.
  portalTokenHash                String?                @unique
  portalTokenIssuedAt            DateTime?
  portalTokenExpiresAt           DateTime?
  // إثبات عرض إشعار الخصوصية قبل التسجيل العام (اطلاع، وليس موافقة تسويقية).
  privacyNoticeAcknowledgedAt    DateTime?
  privacyNoticeVersion           String?
  privacyNoticeControllerName    String?
  // سياسة الحجز: عند الغياب عن موعدين يُعلَّق الحجز الذاتي حتى تصحيح إحدى الحالتين.
  bookingNoShowCount             Int                    @default(0)
  bookingBlockedAt               DateTime?
  bookingBlockReason             String?
  visitCount                     Int                    @default(0)
  totalPaid                      Decimal                @default(0) @db.Decimal(12, 2)
  lastVisitAt                    DateTime?
  lastBarberId                   String?
  createdByBarberId              String?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  organization                   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /**
   * `SetNull` لا `Cascade` ولا `Restrict`: حذف الهوية العالمية يجب ألا يمسّ سجل
   * المؤسسة التشغيلي (زياراته وفواتيره ملك المؤسسة لا الشخص) فيعود السجل إلى
   * حالته القديمة `accountId = NULL`. و`Restrict` كان سيجعل الهوية غير قابلة
   * للحذف ما دام مرتبطًا بها سجل واحد — أي منع حق الشخص في حذف هويته.
   * ولا مسار عكسي أصلًا: المفتاح على `Customer`، فحذف عميل لا يمسّ الحساب.
   */
  account                        CustomerAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdByBarber                Barber?                @relation("CustomerCreatedByBarber", fields: [createdByBarberId], references: [id])
  visits                         Visit[]
  loyaltyAccount                 LoyaltyAccount?
  loyaltyTransactions            LoyaltyTransaction[]
  campaignRedemptions            CampaignRedemption[]
  managerRewards                 ManagerReward[]
  whatsappMessages               WhatsAppMessageLog[]
  appointments                   Appointment[]
  dataSubjectRequests            DataSubjectRequest[]

  @@unique([organizationId, phone])
  /**
   * هوية واحدة لا تملك سجلّين في المؤسسة نفسها.
   * PostgreSQL يعتبر NULL مميّزًا عن NULL في الفهارس الفريدة، فالقيد **لا يقيّد**
   * صفوف `accountId = NULL` إطلاقًا — آلاف العملاء القدامى يتعايشون في المؤسسة
   * الواحدة. (سلوك مُثبَّت باختبار لا مفترض.)
   */
  @@unique([accountId, organizationId])
  @@index([organizationId, lastVisitAt])
  @@index([organizationId, whatsappOptIn])
  @@index([organizationId, whatsappMarketingOptIn])
  @@index([organizationId, whatsappLastMarketingAt])
  @@index([organizationId, bookingBlockedAt])
  @@index([createdByBarberId])
}

model Service {
  id                  String               @id @default(cuid())
  organizationId      String
  salonId             String
  name                String
  defaultPrice        Decimal              @db.Decimal(10, 2)
  isActive            Boolean              @default(true)
  sortOrder           Int                  @default(0)
  // مدة الخدمة بالدقائق — تُستخدم لحساب نهاية الموعد.
  durationMinutes     Int                  @default(30)
  // نسبة عمولة خاصة بهذه الخدمة %. null = استخدم نسبة الحلاق ثم الفرع.
  commissionRate      Decimal?             @db.Decimal(5, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon               Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  visitServices       VisitService[]
  appointmentServices AppointmentService[]

  @@unique([salonId, name])
  @@index([salonId, isActive, sortOrder])
  @@index([organizationId])
}

model Visit {
  id                  String               @id @default(cuid())
  organizationId      String
  salonId             String
  // العملية المالية لا تتطلب بيانات شخصية؛ يبقى العميل اختياريًا للولاء والتاريخ.
  customerId          String?
  barberId            String
  status              VisitStatus          @default(COMPLETED)
  grossAmount         Decimal              @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(10, 2)
  // netAmount = المبلغ المدفوع فعليًا بعد الخصم — أساس كل التجميعات المالية.
  netAmount           Decimal              @db.Decimal(10, 2)
  invoiceNumber       String?
  // عمولة الحلاق محسوبة وقت الزيارة على المبلغ بعد الخصم.
  commissionAmount    Decimal              @default(0) @db.Decimal(10, 2)
  paymentMethod       PaymentMethod
  // تفاصيل التحصيل النقدي لتحويل شاشة الحلاق إلى نقطة بيع فعلية.
  cashTenderedAmount  Decimal?             @db.Decimal(10, 2)
  cashChangeAmount    Decimal?             @db.Decimal(10, 2)
  discountType        DiscountType         @default(NONE)
  discountSourceId    String?
  idempotencyKey      String?
  pointsEarned        Int                  @default(0)
  notes               String?
  closedAt            DateTime?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancelReason        String?
  visitedAt           DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon               Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  barber              Barber               @relation(fields: [barberId], references: [id])
  services            VisitService[]
  loyaltyTransactions LoyaltyTransaction[]
  campaignRedemption  CampaignRedemption?
  managerReward       ManagerReward?
  cancelledBy         User?                @relation("VisitCancelledBy", fields: [cancelledByUserId], references: [id])
  cashSessionId       String?
  cashSession         CashSession?         @relation(fields: [cashSessionId], references: [id])
  whatsappMessages    WhatsAppMessageLog[]
  appointment         Appointment?
  productLines        VisitProduct[]
  stockMovements      StockMovement[]

  @@unique([barberId, idempotencyKey])
  @@unique([salonId, invoiceNumber])
  @@index([organizationId, visitedAt])
  @@index([organizationId, status, visitedAt])
  @@index([salonId, visitedAt])
  @@index([salonId, status, visitedAt])
  @@index([visitedAt])
  @@index([barberId, visitedAt])
  @@index([customerId, visitedAt])
  @@index([status])
  @@index([cancelledByUserId])
  @@index([cashSessionId])
}

model VisitService {
  id               String  @id @default(cuid())
  visitId          String
  serviceId        String
  serviceName      String
  unitPrice        Decimal @db.Decimal(10, 2)
  quantity         Int     @default(1)
  lineTotal        Decimal @db.Decimal(10, 2)
  commissionRate   Decimal @default(0) @db.Decimal(5, 2)
  commissionAmount Decimal @default(0) @db.Decimal(10, 2)
  visit            Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  service          Service @relation(fields: [serviceId], references: [id])

  @@index([visitId])
  @@index([serviceId])
}

/**
 * عضوية الولاء. **نطاقها المؤسسة لا الفرع**: `customerId @unique` مع كون `Customer`
 * مملوكًا لمؤسسة واحدة يعطي عمليًا `UNIQUE(customer, organization)` — فلا يمكن أن
 * يملك العميل رصيدين، ولا أن ينشأ له رصيد ثانٍ بزيارة فرع آخر. الفرع يُسجَّل على
 * حركة الدفتر لأغراض التقارير فقط، ولا يملك وعاء نقاط.
 */
model LoyaltyAccount {
  id               String       @id @default(cuid())
  organizationId   String
  customerId       String       @unique
  points           Int          @default(0)
  lifetimeEarned   Int          @default(0)
  lifetimeRedeemed Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, points])
}

/**
 * دفتر حركات النقاط — سجل التدقيق ومصدر مراجعة الرصيد.
 * `salonId` **مكان وقوع الحركة لا نطاقها**: يُسجَّل ليجيب تقرير الفرع عن «كم نقطة
 * صُدرت من جدة»، ولا يشارك في تحديد أي رصيد. اختياري لأن حركة قد تقع بلا فرع
 * (تسوية إدارية، انتهاء صلاحية مستقبلًا)، ولأن الحركات التاريخية عُبِّئت من
 * `Visit.salonId` وقد تبقى فيها حركة بلا زيارة.
 * `balanceBefore/balanceAfter` لقطة الرصيد حول الحركة على نمط `StockMovement`:
 * الدفتر يُقرأ وحده فيُعرف من أين جاء الرقم بلا إعادة حساب السلسلة كاملة.
 * المنفّذ عمودان لا واحد لأن الفاعل قد يكون حلاقًا (كسب/استبدال في الزيارة) أو
 * موظف لوحة (عكس أو تسوية)، وكلاهما جدول مختلف — نفس نمط `StockMovement`.
 */
model LoyaltyTransaction {
  id                 String                 @id @default(cuid())
  organizationId     String
  customerId         String
  // مكان وقوع الحركة للتقارير فقط. لا يدخل في تحديد الرصيد إطلاقًا.
  salonId            String?
  visitId            String?
  type               LoyaltyTransactionType
  points             Int
  balanceBefore      Int
  balanceAfter       Int
  description        String?
  recordedByUserId   String?
  recordedByBarberId String?
  createdAt          DateTime               @default(now())
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer               @relation(fields: [customerId], references: [id])
  visit              Visit?                 @relation(fields: [visitId], references: [id])

  @@index([customerId, createdAt])
  @@index([visitId])
  @@index([type])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, salonId, createdAt])
  @@index([organizationId, type, createdAt])
}

model RewardRule {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  requiredPoints Int
  discountAmount Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@unique([organizationId, requiredPoints])
  @@index([organizationId, isActive, requiredPoints])
}

model Campaign {
  id                 String               @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  discountType       CampaignDiscountType
  discountValue      Decimal              @db.Decimal(10, 2)
  targetType         CampaignTargetType
  inactiveDays       Int?
  minPoints          Int?
  startAt            DateTime
  endAt              DateTime
  maxUsesPerCustomer Int                  @default(1)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  redemptions        CampaignRedemption[]
  whatsappMessages   WhatsAppMessageLog[]

  @@index([organizationId, isActive, startAt, endAt])
  @@index([targetType])
}

model CampaignRedemption {
  id             String       @id @default(cuid())
  organizationId String
  campaignId     String
  customerId     String
  visitId        String       @unique
  discountAmount Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign     @relation(fields: [campaignId], references: [id])
  customer       Customer     @relation(fields: [customerId], references: [id])
  visit          Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([campaignId, customerId])
  @@index([customerId, createdAt])
  @@index([organizationId])
}

model ManagerReward {
  id              String       @id @default(cuid())
  organizationId  String
  customerId      String
  issuedByUserId  String
  redeemedVisitId String?      @unique
  title           String
  description     String?
  discountAmount  Decimal      @db.Decimal(10, 2)
  expiresAt       DateTime?
  redeemedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  issuedBy        User         @relation("ManagerRewardIssuedBy", fields: [issuedByUserId], references: [id])
  redeemedVisit   Visit?       @relation(fields: [redeemedVisitId], references: [id])

  @@index([customerId, redeemedAt, revokedAt, expiresAt])
  @@index([issuedByUserId, createdAt])
  @@index([redeemedVisitId])
  @@index([organizationId])
}

model DailyClose {
  id                       String       @id @default(cuid())
  organizationId           String
  salonId                  String
  barberId                 String
  date                     DateTime
  visitsCount              Int          @default(0)
  grossTotal               Decimal      @default(0) @db.Decimal(12, 2)
  discountTotal            Decimal      @default(0) @db.Decimal(12, 2)
  netTotal                 Decimal      @default(0) @db.Decimal(12, 2)
  cashTotal                Decimal      @default(0) @db.Decimal(12, 2)
  cardTotal                Decimal      @default(0) @db.Decimal(12, 2)
  pointsEarnedTotal        Int          @default(0)
  pointsRedeemedTotal      Int          @default(0)
  rewardRedemptionsCount   Int          @default(0)
  campaignRedemptionsCount Int          @default(0)
  cashReceivedAmount       Decimal      @default(0) @db.Decimal(12, 2)
  receivedByUserId         String
  receivedAt               DateTime     @default(now())
  notes                    String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon                    Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber                   Barber       @relation(fields: [barberId], references: [id])
  receivedBy               User         @relation("DailyCloseReceivedBy", fields: [receivedByUserId], references: [id])

  @@unique([barberId, date])
  @@index([organizationId, date])
  @@index([salonId, date])
  @@index([date])
  @@index([receivedByUserId])
}

model CashSession {
  id                       String            @id @default(cuid())
  organizationId           String
  salonId                  String
  barberId                 String
  status                   CashSessionStatus @default(OPEN)
  openedAt                 DateTime          @default(now())
  // عهدة بداية الدرج؛ تدخل في المطابقة ولا تُعد إيرادًا.
  openingCashAmount        Decimal           @default(0) @db.Decimal(12, 2)
  closedAt                 DateTime?
  closedByUserId           String?
  visitsCount              Int               @default(0)
  grossTotal               Decimal           @default(0) @db.Decimal(12, 2)
  discountTotal            Decimal           @default(0) @db.Decimal(12, 2)
  netTotal                 Decimal           @default(0) @db.Decimal(12, 2)
  cashTotal                Decimal           @default(0) @db.Decimal(12, 2)
  cardTotal                Decimal           @default(0) @db.Decimal(12, 2)
  pointsEarnedTotal        Int               @default(0)
  pointsRedeemedTotal      Int               @default(0)
  rewardRedemptionsCount   Int               @default(0)
  campaignRedemptionsCount Int               @default(0)
  cashReceivedAmount       Decimal?          @db.Decimal(12, 2)
  // مصروفات نثرية خرجت من الدرج خلال الجلسة — تُخصم من الكاش المتوقع.
  expensesTotal            Decimal           @default(0) @db.Decimal(12, 2)
  notes                    String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon                    Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber                   Barber            @relation(fields: [barberId], references: [id])
  closedBy                 User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  visits                   Visit[]
  expenses                 CashExpense[]
  cashCollections          CashCollection[]
  // تحويلات التحصيل التي خرجت من الدرج أثناء الجلسة؛ لا تُعد إيرادًا ولا مصروفًا.
  collectionsTotal         Decimal           @default(0) @db.Decimal(12, 2)

  @@index([organizationId, status])
  @@index([organizationId, status, closedAt])
  @@index([salonId, status])
  @@index([salonId, status, closedAt])
  @@index([barberId, status])
  @@index([openedAt])
  @@index([closedAt])
  @@index([closedByUserId])
}

model SystemSettings {
  id                            String       @id @default(cuid())
  organizationId                String
  salonId                       String?      @unique
  singletonKey                  String?
  salonName                     String
  currency                      String       @default("SAR")
  pointsPerCurrencyUnit         Decimal      @default(1) @db.Decimal(8, 2)
  pointsCalculatedAfterDiscount Boolean      @default(true)
  allowMultipleDiscounts        Boolean      @default(false)
  whatsappDefaultCountryCode    String       @default("966")
  whatsappEnabled               Boolean      @default(true)
  // الاسم الذي يظهر في هوية الصالون والإيصالات التشغيلية.
  legalName                     String?
  // نسبة العمولة الافتراضية للفرع %. تُستخدم إن لم تُحدَّد للحلاق أو الخدمة.
  defaultCommissionRate         Decimal      @default(0) @db.Decimal(5, 2)
  // أقصى مصروف يسجّله الحلاق بنفسه من درج الكاش. ما فوقه يلزمه مدير الفرع.
  // بلا سقف يستطيع الحلاق تخفيض «الكاش المتوقع» بمصروف كبير وقت الإغلاق فيختفي
  // العجز، والتدقيق يكشفه بعد وقوعه لا قبله.
  barberExpenseLimit            Decimal      @default(200) @db.Decimal(10, 2)
  // الحجز الذاتي من بوابة العميل — معطّل افتراضيًا حتى يفعّله المالك صراحةً.
  // تعطيله يعيد سلوك النظام السابق حرفيًا: الحجز من الموظفين فقط.
  bookingEnabled                Boolean      @default(false)
  // ساعات استقبال الحجز كدقائق من منتصف الليل (0..1439) بتوقيت الصالون المحلي.
  // دقائق لا نص: تُقارن وتُولَّد حسابيًا بلا تحليل نصوص في كل فترة.
  bookingOpenMinute             Int          @default(960)
  bookingCloseMinute            Int          @default(1380)
  // طول الفترة المعروضة للعميل بالدقائق (هي أيضًا مدة الموعد الافتراضية).
  bookingSlotMinutes            Int          @default(30)
  // أيام الإغلاق الأسبوعية: 0=الأحد .. 6=السبت.
  bookingClosedWeekdays         Int[]        @default([])
  // أقل مهلة بين الآن وبداية الموعد — تمنع حجزًا بعد دقيقتين والحلاق على الكرسي.
  bookingLeadMinutes            Int          @default(120)
  // مدى الحجز المستقبلي بالأيام.
  bookingHorizonDays            Int          @default(14)
  // أقصى عدد مواعيد قائمة للعميل الواحد — يمنع حجز مقاعد وهمية.
  bookingMaxActivePerCustomer   Int          @default(2)
  // كم دقيقة يُطلب من العميل الحضور قبل موعده. إرشاد يُعرض له، لا قيد يُفحص:
  // لا يزحزح بداية الموعد ولا يدخل حساب التداخل. صفر = لا يُعرض الإرشاد.
  bookingArriveEarlyMinutes     Int          @default(10)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon                         Salon?       @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// عدّاد تسلسلي للفواتير لكل فرع لكل سنة. يُزاد داخل معاملة تأكيد الزيارة.
model InvoiceCounter {
  id             String   @id @default(cuid())
  organizationId String
  salonId        String
  year           Int
  lastNumber     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([salonId, year])
  @@index([organizationId])
}

model WhatsAppTemplate {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  type           WhatsAppTemplateType
  body           String
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       WhatsAppMessageLog[]

  @@index([organizationId, type, isActive])
}

model WhatsAppMessageLog {
  id                 String                  @id @default(cuid())
  organizationId     String
  customerId         String
  templateId         String?
  campaignId         String?
  visitId            String?
  phone              String
  message            String
  waUrl              String
  status             WhatsAppMessageStatus   @default(DRAFTED)
  category           WhatsAppMessageCategory @default(SERVICE)
  policySnapshot     Json?
  openedByUserId     String?
  openedAt           DateTime?
  markedSentByUserId String?
  markedSentAt       DateTime?
  skippedReason      String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template           WhatsAppTemplate?       @relation(fields: [templateId], references: [id])
  campaign           Campaign?               @relation(fields: [campaignId], references: [id])
  visit              Visit?                  @relation(fields: [visitId], references: [id])
  openedBy           User?                   @relation("WhatsAppOpenedBy", fields: [openedByUserId], references: [id])
  markedSentBy       User?                   @relation("WhatsAppMarkedSentBy", fields: [markedSentByUserId], references: [id])

  @@index([customerId, createdAt])
  @@index([organizationId, category, createdAt])
  @@index([templateId])
  @@index([campaignId])
  @@index([visitId])
  @@index([status, createdAt])
  @@index([openedByUserId])
  @@index([markedSentByUserId])
  @@index([organizationId])
}

model WhatsAppSafetySettings {
  id                            String             @id @default(cuid())
  organizationId                String             @unique
  mode                          WhatsAppSafetyMode @default(STRICT)
  marketingCooldownHours        Int                @default(168)
  maxMarketingPerCustomer30Days Int                @default(4)
  maxMessagesPerCustomer24Hours Int                @default(2)
  dailyOrganizationDraftLimit   Int                @default(100)
  appendOptOutInstructions      Boolean            @default(true)
  optOutText                    String             @default("لإيقاف العروض اكتب إيقاف")
  marketingPaused               Boolean            @default(false)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  organization                  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([mode])
}

// مصروف نثري من درج الكاش. يُخصم من الكاش المتوقع عند إغلاق الجلسة
// حتى يصبح فرق الصندوق قابلًا للتفسير بدل أن يظهر كعجز.
model CashExpense {
  id                 String               @id @default(cuid())
  organizationId     String
  salonId            String
  cashSessionId      String?
  barberId           String?
  amount             Decimal              @db.Decimal(10, 2)
  category           ExpenseCategory      @default(OTHER)
  paymentSource      ExpensePaymentSource @default(CASH_DRAWER)
  note               String
  payee              String?
  reference          String?
  recordedByUserId   String?
  recordedByBarberId String?
  // تاريخ استحقاق/حدوث المصروف مستقل عن وقت إدخاله للنظام.
  expenseDate        DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  barber       Barber?      @relation("CashExpenseBarber", fields: [barberId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, expenseDate])
  @@index([salonId, createdAt])
  @@index([salonId, expenseDate])
  @@index([cashSessionId])
  @@index([barberId])
  @@index([organizationId, paymentSource, createdAt])
}

// رصيد العهدة الفعلي لدى الحلاق. يبدأ غير مهيأ حتى يثبّت المدير أول عدّ فعلي،
// حتى لا نستنتج أرصدة تاريخية قد تكون حُصّلت خارج النظام.
model BarberCashBalance {
  barberId       String    @id
  organizationId String
  salonId        String
  balance        Decimal   @default(0) @db.Decimal(12, 2)
  isInitialized  Boolean   @default(false)
  initializedAt  DateTime?
  lastMovementAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([organizationId, salonId])
  @@index([salonId, isInitialized])
}

// خزنة الفرع مستقلة عن الإيراد؛ التحصيل يزيدها والسحب للمالك/البنك ينقصها.
model BranchCashSafe {
  salonId        String    @id
  organizationId String
  balance        Decimal   @default(0) @db.Decimal(12, 2)
  lastMovementAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// دفتر أستاذ غير قابل للتعديل: كل تغير يُسجل كحركة جديدة مع الرصيد قبلها وبعدها.
model CashCustodyMovement {
  id                  String                  @id @default(cuid())
  organizationId      String
  salonId             String
  barberId            String?
  cashSessionId       String?
  type                CashCustodyMovementType
  amount              Decimal                 @db.Decimal(12, 2)
  barberDelta         Decimal                 @default(0) @db.Decimal(12, 2)
  branchDelta         Decimal                 @default(0) @db.Decimal(12, 2)
  barberBalanceBefore Decimal?                @db.Decimal(12, 2)
  barberBalanceAfter  Decimal?                @db.Decimal(12, 2)
  branchBalanceBefore Decimal?                @db.Decimal(12, 2)
  branchBalanceAfter  Decimal?                @db.Decimal(12, 2)
  referenceKey        String                  @unique
  referenceId         String?
  note                String?
  actorType           AuditActorType
  actorUserId         String?
  actorBarberId       String?
  occurredAt          DateTime                @default(now())
  createdAt           DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([salonId, occurredAt])
  @@index([barberId, occurredAt])
  @@index([cashSessionId])
  @@index([referenceId])
}

// إيصال تحصيل: يثبت العد، المبلغ المستلم، والمتبقي لدى الحلاق. لا يُعدل؛ الخطأ يُعكس.
model CashCollection {
  id                String    @id @default(cuid())
  organizationId    String
  salonId           String
  barberId          String
  cashSessionId     String?
  collectedByUserId String
  expectedBefore    Decimal   @db.Decimal(12, 2)
  countedAmount     Decimal   @db.Decimal(12, 2)
  discrepancyAmount Decimal   @default(0) @db.Decimal(12, 2)
  discrepancyReason String?
  collectedAmount   Decimal   @db.Decimal(12, 2)
  remainingAfter    Decimal   @db.Decimal(12, 2)
  branchSafeAfter   Decimal   @db.Decimal(12, 2)
  note              String?
  idempotencyKey    String
  collectedAt       DateTime  @default(now())
  reversedAt        DateTime?
  reversedByUserId  String?
  reversalReason    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id])
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  collectedBy  User         @relation("CashCollectionCollectedBy", fields: [collectedByUserId], references: [id])
  reversedBy   User?        @relation("CashCollectionReversedBy", fields: [reversedByUserId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([salonId, collectedAt])
  @@index([barberId, collectedAt])
  @@index([cashSessionId])
  @@index([reversedAt])
}

// تذكير اختياري فقط؛ لا ينشئ أي حركة مالية تلقائيًا.
model CashCollectionPolicy {
  salonId         String                     @id
  organizationId  String
  mode            CashCollectionScheduleMode @default(DISABLED)
  intervalDays    Int                        @default(1)
  weekdays        Int[]                      @default([])
  thresholdAmount Decimal?                   @db.Decimal(12, 2)
  reminderHour    Int                        @default(17)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/**
 * صرف عمولة حلاق.
 * **دفتر رصيد جارٍ لا تسوية شهر:** المتبقي = مجموع العمولات المستحقة من الزيارات
 * المكتملة ناقص مجموع ما صُرف غير المعكوس. الفترة هنا وصفية للإيصال فقط، لأن
 * التسوية بالفترة تنكسر عند إلغاء زيارة قديمة أو تسجيل زيارة متأخرة.
 * **ليس مصروفًا:** العمولة تُطرح من ربح المؤسسة مرة واحدة وقت الاستحقاق. لو
 * سُجّل الصرف مصروفًا لطُرح مرتين. لذلك الكيان مستقل عن `CashExpense`.
 */
model CommissionPayout {
  id                 String                 @id @default(cuid())
  organizationId     String
  // الفرع الذي خرج منه المال — يخص دفتر الخزنة لا احتساب الاستحقاق.
  salonId            String
  barberId           String
  periodFrom         DateTime
  periodTo           DateTime
  amount             Decimal                @db.Decimal(12, 2)
  method             CommissionPayoutMethod
  reference          String?
  note               String?
  // لقطات تجعل الإيصال يشرح نفسه بعد سنة بلا إعادة حساب التاريخ كله.
  accruedSnapshot    Decimal                @db.Decimal(12, 2)
  paidBeforeSnapshot Decimal                @db.Decimal(12, 2)
  outstandingAfter   Decimal                @db.Decimal(12, 2)
  paidByUserId       String
  paidAt             DateTime               @default(now())
  reversedAt         DateTime?
  reversedByUserId   String?
  reversalReason     String?
  idempotencyKey     String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id])
  paidBy       User         @relation("CommissionPayoutPaidBy", fields: [paidByUserId], references: [id])
  reversedBy   User?        @relation("CommissionPayoutReversedBy", fields: [reversedByUserId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([barberId, paidAt])
  @@index([organizationId, paidAt])
  @@index([salonId, paidAt])
  @@index([reversedAt])
}

// موعد حجز. الصالون walk-in أصلًا، فالموعد اختياري ولا يمنع تسجيل زيارة بدونه.
model Appointment {
  id              String            @id @default(cuid())
  organizationId  String
  salonId         String
  barberId        String?
  customerId      String?
  customerName    String
  customerPhone   String
  startAt         DateTime
  durationMinutes Int               @default(30)
  status          AppointmentStatus @default(BOOKED)
  source          AppointmentSource @default(STAFF)
  notes           String?
  // الزيارة الناتجة عن الموعد عند وصول العميل وإتمام الخدمة.
  visitId         String?           @unique
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber?              @relation(fields: [barberId], references: [id], onDelete: SetNull)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visit        Visit?               @relation(fields: [visitId], references: [id], onDelete: SetNull)
  services     AppointmentService[]

  @@index([salonId, startAt])
  @@index([organizationId, startAt])
  @@index([organizationId, salonId, status, startAt])
  @@index([barberId, startAt])
  @@index([status, startAt])
  @@index([customerId])
}

/**
 * الخدمات المطلوبة في الموعد — مصدر مدّته.
 * جدول سطور على نمط `VisitService`: لا يكرّر `organizationId`، والعزل بينه وبين
 * المستأجرين محفّز في القاعدة يقارن مؤسسة الموعد بمؤسسة الخدمة.
 * المدة **لقطة وقت الحجز** كنسبة العمولة و`VisitProduct.unitCost` تمامًا: تعديل
 * مدة خدمة في الكتالوج لا يجوز أن يزحزح موعدًا محجوزًا سبق أن أُبلغ به العميل.
 */
model AppointmentService {
  id              String  @id @default(cuid())
  appointmentId   String
  serviceId       String
  serviceName     String
  durationMinutes Int
  // سعر إرشادي يُعرض للعميل وقت الحجز. المبلغ المُحصَّل يُحسم في الزيارة وحدها.
  estimatedPrice  Decimal @db.Decimal(10, 2)
  sortOrder       Int     @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  // خدمة واحدة لا تتكرر في الموعد: التكرار يعني مدة مضاعفة بلا قصد ظاهر.
  @@unique([appointmentId, serviceId])
  @@index([appointmentId])
  @@index([serviceId])
}

// منتج للبيع (شمع، شامبو...). المخزون رقم صحيح بسيط — لا دفعات ولا صلاحيات.
model Product {
  id                String   @id @default(cuid())
  organizationId    String
  salonId           String
  name              String
  sku               String?
  price             Decimal  @db.Decimal(10, 2)
  costPrice         Decimal? @db.Decimal(10, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(3)
  commissionRate    Decimal? @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon         Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  visitProducts VisitProduct[]
  movements     StockMovement[]

  @@unique([salonId, name])
  @@index([salonId, isActive, sortOrder])
  @@index([organizationId])
}

// سطر منتج مباع ضمن زيارة — نسخة من الاسم والسعر وقت البيع.
model VisitProduct {
  id               String   @id @default(cuid())
  visitId          String
  productId        String
  productName      String
  unitPrice        Decimal  @db.Decimal(10, 2)
  // تكلفة الوحدة **لحظة البيع**، كنسبة العمولة تمامًا: تعديل تكلفة المنتج لاحقًا
  // لا يجوز أن يعيد كتابة أرباح شهور مضت. `null` = لم تُسجَّل تكلفة للمنتج.
  unitCost         Decimal? @db.Decimal(10, 2)
  quantity         Int      @default(1)
  lineTotal        Decimal  @db.Decimal(10, 2)
  commissionRate   Decimal  @default(0) @db.Decimal(5, 2)
  commissionAmount Decimal  @default(0) @db.Decimal(10, 2)

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([visitId])
  @@index([productId])
}

// حركة مخزون. كل تغيير في الكمية يمرّ من هنا — المخزون قابل للتدقيق لا رقم يُكتب فوقه.
model StockMovement {
  id                 String            @id @default(cuid())
  organizationId     String
  salonId            String
  productId          String
  type               StockMovementType
  quantity           Int
  balanceAfter       Int
  reason             String?
  visitId            String?
  recordedByUserId   String?
  recordedByBarberId String?
  createdAt          DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  visit        Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([salonId, createdAt])
  @@index([organizationId, createdAt])
  @@index([visitId])
}

// حضور وانصراف الحلاق. سجل مستقل عن جلسة الصندوق: الجلسة أداة مالية والحضور أداة إدارية.
model AttendanceRecord {
  id             String           @id @default(cuid())
  organizationId String
  salonId        String
  barberId       String
  checkInAt      DateTime         @default(now())
  checkOutAt     DateTime?
  source         AttendanceSource @default(SELF)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salon        Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  barber       Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, checkInAt])
  @@index([salonId, checkInAt])
  @@index([organizationId, checkInAt])
}

// فاتورة اشتراك المؤسسة في المنصّة (مقابل فاتورة الزيارة للعميل).
// مصدر الحقيقة لما دُفع فعلًا؛ حالة الاشتراك على `Organization` مشتقّة منها.
model BillingInvoice {
  id                        String               @id @default(cuid())
  organizationId            String
  planId                    String?
  provider                  PaymentProvider      @default(MANUAL_TRANSFER)
  status                    BillingInvoiceStatus @default(PAID)
  // بالريال. يُخزَّن كما حُصِّل فعلًا لا كما هو في الباقة اليوم.
  amount                    Decimal              @db.Decimal(10, 2)
  currency                  String               @default("SAR")
  // رقم فاتورة اشتراك XMANSX؛ يصدر عند اعتماد الدفعة ويظل ثابتًا.
  invoiceNumber             String?              @unique
  issuedAt                  DateTime?
  sellerName                String?
  sellerFreelanceDocument   String?
  sellerActivity            String?
  buyerName                 String?
  buyerCity                 String?
  periodMonths              Int                  @default(1)
  // مرجع العملية (رقم الحوالة/الإيصال) — فريد لمنع تسجيل الدفعة مرتين.
  reference                 String?              @unique
  note                      String?
  paidAt                    DateTime?
  periodStart               DateTime?
  periodEnd                 DateTime?
  // مدير المنصة الذي سجّل الدفعة — الفوترة من اختصاصه لا اختصاص المستأجر.
  recordedByPlatformAdminId String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@index([planId])
}

model BillingInvoiceCounter {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DataSubjectRequest {
  id                         String                   @id @default(cuid())
  organizationId             String
  customerId                 String?
  type                       DataSubjectRequestType
  status                     DataSubjectRequestStatus @default(OPEN)
  details                    String?
  requestedName              String?
  requestedPhone             String?
  identityVerifiedAt         DateTime?
  identityVerificationMethod String?
  executedAt                 DateTime?
  resolutionNote             String?
  resolvedAt                 DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([customerId, createdAt])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

model AuditLog {
  id             String         @id @default(cuid())
  organizationId String?
  salonId        String?
  actorType      AuditActorType
  actorUserId    String?
  actorBarberId  String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?          @relation(fields: [actorUserId], references: [id])
  actorBarber    Barber?        @relation("BarberAuditLogs", fields: [actorBarberId], references: [id])

  @@index([createdAt])
  @@index([actorType, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}
