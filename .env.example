DATABASE_URL="postgresql://tanal_user:tanal_dev_password@localhost:55432/tanal_loyalty?schema=public"
# حدود كل نسخة Node؛ اضربها في عدد النسخ وتأكد أنها دون max_connections.
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="10"

# مفتاح مستقل لتشفير أسرار TOTP لمديري المنصة (32 byte بصيغة base64).
# مثال توليد آمن: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATFORM_MFA_ENCRYPTION_KEY=""
# روابط بوابة العميل تنتهي تلقائيًا؛ الحد الأقصى المقبول داخل التطبيق 90 يومًا.
PORTAL_TOKEN_TTL_DAYS="30"

# Redis مشترك للـ rate limiting الذري والكاش القصير للوحة التحكم.
# اتركه فارغًا محليًا ليعمل بديل PostgreSQL. في الإنتاج اضبط REDIS_REQUIRED=true.
REDIS_URL=""
REDIS_REQUIRED="false"
REDIS_KEY_PREFIX="xmansx"
DASHBOARD_CACHE_TTL_SECONDS="10"

# بيانات التحويل التي تظهر للمالك والمدير في صفحة «اشتراكي».
SUBSCRIPTION_BANK_NAME="مصرف الراجحي"
SUBSCRIPTION_ACCOUNT_NAME="MANSOUR ALGHAMDI"
SUBSCRIPTION_IBAN="SA85 8000 0660 6080 1622 0957"

# بيانات عامة تظهر في الصفحات القانونية والفواتير. تحقق منها قبل بدء البيع.
PUBLIC_SUPPORT_EMAIL="support@xmansx.com"
PUBLIC_PRIVACY_EMAIL="support@xmansx.com"
PUBLIC_SUPPORT_PHONE="0537720207"
PUBLIC_SUPPORT_WHATSAPP="966537720207"
PUBLIC_BUSINESS_ADDRESS="الرياض، المملكة العربية السعودية"
# اكتب الدولة والمدينة الفعلية لمركز البيانات الأساسي، مثل: المملكة العربية السعودية - الرياض.
PUBLIC_DATA_HOSTING_LOCATION=""
# بيانات توثيق التجارة الإلكترونية الصادرة من المركز السعودي للأعمال، إن صدرت.
PUBLIC_ECOMMERCE_VERIFICATION_NUMBER=""
PUBLIC_ECOMMERCE_VERIFICATION_URL=""

# النسخ الاحتياطية المشفرة تحذف بعد هذه المدة من إنشائها (1 إلى 365 يومًا).
BACKUP_RETENTION_DAYS="30"

# Seed credentials for local development only.
REQUIRE_EXPLICIT_SEED_CREDENTIALS="false"
SEED_ADMIN_PHONE="0500000001"
SEED_ADMIN_EMAIL="admin@tanal.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_BARBER_PHONE="0500000002"
SEED_BARBER_PIN="Tanal@123"
SEED_SUPERVISOR_PHONE="0500000003"
SEED_SUPERVISOR_EMAIL="supervisor@tanal.local"
SEED_SUPERVISOR_PASSWORD="Super@12345"
# Platform super-admin (manages all organizations and plans at platform.<root>).
PLATFORM_ADMIN_EMAIL="platform@tanal.local"
PLATFORM_ADMIN_PASSWORD="Platform@12345"

# Security / operations (optional locally).
# Comma-separated list of trusted browser origins for CSRF Origin checks.
# Same-origin requests are always allowed; set this only for extra origins.
ALLOWED_ORIGINS=""
# Shared secret for the scheduled maintenance cleanup endpoint
# (POST /api/maintenance/cleanup with header x-maintenance-token).
MAINTENANCE_TOKEN=""
# Logging verbosity: debug | info | warn | error.
LOG_LEVEL="debug"

# البريد التشغيلي للعملاء عبر Resend. استخدم مفتاحًا مستقلًا بصلاحية sending_access فقط.
# لا تشارك مفتاح مشروع آخر ولا تحفظ القيمة الحقيقية في المستودع.
RESEND_API_KEY=""
EMAIL_FROM="XMANSX | إكس مانس <notifications@xmansx.com>"
EMAIL_REPLY_TO="support@xmansx.com"
EMAIL_PLATFORM_TAG="xmansx"
# مفتاح مستقل بصلاحية full_access لاسترجاع البريد الوارد ومرفقاته من Resend.
# لا يُستخدم في الواجهة أو الإرسال العادي، ولا يُشارك مع أي منصة أخرى.
RESEND_INBOUND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
SUPPORT_EMAIL_ADDRESS="support@xmansx.com"
INBOUND_EMAIL_REQUIRED="false"
# في الإنتاج اجعله true بعد إضافة المفتاح والتحقق من النطاق؛ عندها يفشل readiness
# بدل تشغيل إصدار غير قادر على إرسال رسائل العملاء.
EMAIL_REQUIRED="false"
# سر مستقل لتوقيع رموز تحقق حسابات العملاء (وليس رمزًا أو مفتاح Resend).
# ولّد قيمة عشوائية قوية لكل بيئة، ولا تحفظ قيمة الإنتاج في المستودع.
CUSTOMER_OTP_PEPPER=""

# تنبيهات حجوزات الحلاق عبر Web Push.
# أنشئ الزوج مرة واحدة فقط: npx web-push generate-vapid-keys
# المفتاح العام آمن للمتصفح؛ الخاص يبقى سرًا على الخادم ولا يُرسل للواجهة.
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
# بريد التواصل الرسمي لمسؤول خدمة Push.
WEB_PUSH_SUBJECT="mailto:support@xmansx.com"
# Root domain for multi-tenant subdomains (e.g. tanal.com -> owner.tanal.com).
# Leave empty for localhost/dev: requests then resolve to the default organization.
ROOT_DOMAIN=""

# Production checklist (any host running Node 22 + PostgreSQL):
# - DATABASE_URL points at your production PostgreSQL.
# - REDIS_URL points at a private Redis instance and REDIS_REQUIRED is true.
# - DATABASE_CONNECTION_LIMIT × app instances stays below PostgreSQL max_connections.
# - Set REQUIRE_EXPLICIT_SEED_CREDENTIALS="true" so the seed refuses demo passwords.
# - Provide real SEED_* and PLATFORM_ADMIN_* values as server secrets; never commit them.
# - Set ROOT_DOMAIN to your apex domain (for example tanal.com) after wildcard DNS is configured.
#   Leave it EMPTY if you serve a single domain — a wrong value breaks every login.
# - Set ALLOWED_ORIGINS to your public web URL, and MAINTENANCE_TOKEN to a strong secret.
# - Set PUBLIC_APP_URL to the public origin so loyalty QR links resolve.
# - Set PUBLIC_BUSINESS_ADDRESS and PUBLIC_DATA_HOSTING_LOCATION to truthful public values.
# - Set ecommerce verification data after it is officially issued, and keep BACKUP_RETENTION_DAYS explicit.
#   IMPORTANT: it must be present at BUILD time too. The landing page is statically
#   prerendered, so its canonical URL and og:image link are baked during `next build`;
#   setting it only at runtime leaves localhost in the WhatsApp/Twitter link preview.
# - Run `npm run start:prod` so migrations apply before the server accepts traffic.

# العنوان العام للتطبيق — يُستخدم لبناء رمز QR لملصق التسجيل في برنامج الولاء.
# اتركه فارغًا محليًا؛ اضبطه في الإنتاج مثل https://tanal.com
PUBLIC_APP_URL=""

# سرّ الخادم لبصمات رموز تحقق العملاء (HMAC). إلزامي لتشغيل تسجيل العملاء.
# غيّره ليُبطل كل رموز التحقق القائمة فورًا.
CUSTOMER_OTP_PEPPER=""
